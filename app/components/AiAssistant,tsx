// app/components/AiAssistant.tsx
"use client";
import { useState } from "react";

export default function AiAssistant() {
  const [open, setOpen] = useState(false);
  const [msg, setMsg] = useState("");
  const [chat, setChat] = useState<{me: string, ai: string}[]>([]);

  function askAI() {
    if (!msg.trim()) return;
    const userMsg = msg;
    let reply = "";

    const m = userMsg.toLowerCase();
    if (m.includes("hi") || m.includes("hello") || m.includes("yo")) {
      reply = "Yo bruvv what's good? Wanna go LIVE or find someone to watch?";
    } else if (m.includes("recommend") || m.includes("suggest") || m.includes("watch")) {
      reply = "Bet, based on what you like, check the LIVE creators on top of your feed right now.";
    } else if (m.includes("live") || m.includes("stream")) {
      reply = "Let's go LIVE! Is your camera ready and are you 18+ verified? Say 'I'm ready' and I'll put you on.";
    } else if (m.includes("trending") || m.includes("popular")) {
      reply = "Trending now is LIVE creators getting the most ❤️🔥 in the last hour. Want music, dance, talk or gaming?";
    } else if (m.includes("report") || m.includes("block")) {
      reply = "Got you. Give me their @name and I'll hide them and send to moderation.";
    } else {
      reply = `I hear you - you said: "${userMsg}". Want me to find creators for you or help you go LIVE?`;
    }

    setChat([...chat, { me: userMsg, ai: reply }]);
    setMsg("");
  }

  return (
    <div style={{ position: "fixed", bottom: 20, right: 20, zIndex: 9999 }}>
      {!open && (
        <button
          onClick={() => setOpen(true)}
          style={{ background: "#ff2d55", color: "#fff", border: "none", padding: "14px 18px", borderRadius: "50px", fontWeight: "bold", cursor: "pointer" }}
        >
          🤖 Loomi AI
        </button>
      )}
      {open && (
        <div style={{ width: 320, height: 420, background: "#111", color: "#fff", borderRadius: 16, display: "flex", flexDirection: "column", overflow: "hidden", border: "1px solid #333" }}>
          <div style={{ padding: 12, background: "#ff2d55", display: "flex", justifyContent: "space-between" }}>
            <b>🤖 Loomi AI Assistant</b>
            <button onClick={() => setOpen(false)} style={{ background: "none", border: "none", color: "#fff", cursor: "pointer" }}>X</button>
          </div>
          <div style={{ flex: 1, padding: 12, overflowY: "auto" }}>
            {chat.length === 0 && <p style={{ opacity: 0.7 }}>Yo, ask me anything about Loomi-Live...</p>}
            {chat.map((c, i) => (
              <div key={i} style={{ marginBottom: 12 }}>
                <div style={{ textAlign: "right", background: "#222", padding: 8, borderRadius: 10 }}>{c.me}</div>
                <div style={{ marginTop: 6, background: "#ff2d55", padding: 8, borderRadius: 10 }}>{c.ai}</div>
              </div>
            ))}
          </div>
          <div style={{ display: "flex", padding: 10, gap: 6 }}>
            <input
              value={msg}
              onChange={(e) => setMsg(e.target.value)}
              onKeyDown={(e) => e.key === "Enter" && askAI()}
              placeholder="Ask Loomi AI..."
              style={{ flex: 1, padding: 10, borderRadius: 10, border: "none", outline: "none" }}
            />
            <button onClick={askAI} style={{ background: "#ff2d55", color: "#fff", border: "none", padding: "10px 14px", borderRadius: 10, cursor: "pointer" }}>Send</button>
          </div>
        </div>
      )}
    </div>
  );
}
